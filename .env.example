EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat — used for the Apple paywall (StoreKit) flow.
# Get the iOS public API key from https://app.revenuecat.com → project → API keys.
# Leave empty to disable IAP (Premium screen falls back to a no-op).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
